# === REQUIRED ===
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# === MT5 Bridge (optional for dry run) ===
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Valetax-Demo

# === LLM Settings ===
# Override models (uses config defaults if not set)
# LLM_MODEL=openai/gpt-oss-20b:free
# LLM_BASE_URL=https://openrouter.ai/api/v1  # or local LM Studio: http://localhost:1234/v1

# === Mode ===
DRY_RUN=true

# === Telegram (optional) ===
# Create bot via @BotFather, then paste token here:
# TELEGRAM_BOT_TOKEN=1234567890:ABC...
# Auto-filled on first message — leave blank:
# TELEGRAM_CHAT_ID=
# For forum groups (topic threads), set the topic ID:
# TELEGRAM_TOPIC_ID=
